{
  "name": "manager-web",
  "version": "0.1.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "node scripts/build.mjs",
    "vercel-build": "npm run build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:config": "node --test scripts/api-base-url.test.mjs scripts/expiry-date.test.mjs scripts/dependency-compatibility.test.mjs scripts/ensure-default-policy.test.mjs",
    "test:build-config": "node scripts/verify-build-config.mjs",
    "test:ci": "npm run test:config && ng test --watch=false --browsers=ChromeHeadless --no-progress"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/forms": "^21.2.26",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.26",
    "@angular/platform-browser-dynamic": "^21.2.26",
    "@angular/router": "^21.2.26",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.22",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "puppeteer-core": "25.19.0",
    "typescript": "~5.9.3"
  },
  "overrides": {
    "@npmcli/package-json": {
      "glob": "14.0.6"
    },
    "cacache": {
      "glob": "14.0.6"
    },
    "@tufjs/models": {
      "minimatch": "11.0.9"
    },
    "ignore-walk": {
      "minimatch": "11.0.9"
    },
    "sockjs": {
      "uuid": "11.1.1"
    }
  }
}
