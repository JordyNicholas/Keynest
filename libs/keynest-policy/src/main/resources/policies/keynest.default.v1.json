{
  "id": "keynest.default.v1",
  "version": 1,
  "description": "Default Keynest password standard for generate, create, update, and rotate.",
  "appliesTo": ["generate", "create", "update", "rotate"],
  "rules": {
    "minLength": 16,
    "maxLength": 128,
    "requireUpper": true,
    "requireLower": true,
    "requireDigit": true,
    "requireSymbol": true,
    "minCategories": 3,
    "excludeAmbiguous": true,
    "forbidWhitespace": true,
    "forbidUsernameSubstring": true,
    "maxAgeDays": 90,
    "bannedSubstrings": []
  }
}
