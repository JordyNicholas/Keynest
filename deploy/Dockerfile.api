# Build context: repository root
FROM maven:3.9.9-eclipse-temurin-21 AS build
WORKDIR /src
COPY pom.xml .
COPY libs ./libs
COPY apps/manager-api ./apps/manager-api
RUN mvn -pl apps/manager-api -am -DskipTests package

FROM eclipse-temurin:21-jre
RUN groupadd --gid 10001 keynest \
  && useradd --uid 10001 --gid keynest --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin keynest
WORKDIR /app
COPY --from=build /src/apps/manager-api/target/manager-api-0.1.0-SNAPSHOT.jar app.jar
ENV JAVA_TOOL_OPTIONS="-XX:-HeapDumpOnOutOfMemoryError -XX:-CreateCoredumpOnCrash -XX:+DisableAttachMechanism -XX:ErrorFile=/dev/null"
USER 10001:10001
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
