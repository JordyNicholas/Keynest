# Copy to deploy/oracle.env on the VM (chmod 600). Used with:
#   docker compose --env-file deploy/oracle.env -f deploy/docker-compose.yml up -d --build
#
# Do not commit real secrets.

SPRING_PROFILES_ACTIVE=docker

KEYNEST_DB_HOST=postgres
KEYNEST_DB_PORT=5432
KEYNEST_DB_NAME=keynest
KEYNEST_DB_USER=keynest
KEYNEST_DB_PASSWORD=change-me-strong-db-password

# 32-byte AES key as 64 hex characters — generate a new one for the VM:
#   openssl rand -hex 32
KEYNEST_VAULT_KEY_HEX=replace-with-openssl-rand-hex-32-output
KEYNEST_VAULT_KEY_ID=vault-v1

# Comma-separated browser origins allowed to call the API (Vercel UI + local).
KEYNEST_CORS_ALLOWED_ORIGINS=https://keynest-manager.vercel.app,http://localhost:4200
