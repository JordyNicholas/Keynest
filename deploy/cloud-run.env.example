# Example env values for Cloud Run (do not commit secrets).
# Map these into `gcloud run deploy --set-env-vars=...` or Secret Manager.

SPRING_PROFILES_ACTIVE=docker

# From Neon: convert postgresql://… → jdbc:postgresql://…?sslmode=require
KEYNEST_JDBC_URL=jdbc:postgresql://ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
KEYNEST_DB_USER=neondb_owner
KEYNEST_DB_PASSWORD=change-me

# openssl rand -hex 32
KEYNEST_VAULT_KEY_HEX=replace-with-openssl-rand-hex-32-output
KEYNEST_VAULT_KEY_ID=vault-v1

KEYNEST_CORS_ALLOWED_ORIGINS=https://keynest-manager.vercel.app,http://localhost:4200
