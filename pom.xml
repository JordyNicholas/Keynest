<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.keynest</groupId>
  <artifactId>keynest</artifactId>
  <version>0.1.1</version>
  <packaging>pom</packaging>
  <name>Keynest</name>
  <description>Password tools platform and Manager product</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>libs/keynest-policy</module>
    <module>libs/keynest-generate</module>
    <module>libs/keynest-seal</module>
    <module>apps/manager-api</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>4.0.10</spring-boot.version>
    <junit.version>5.11.4</junit.version>
    <archunit.version>1.5.1</archunit.version>
    <jacoco.version>0.8.16</jacoco.version>
    <argon2.version>2.11</argon2.version>
    <jackson.version>2.21.8</jackson.version>
    <tomcat.version>11.0.29</tomcat.version>
    <json-schema-validator.version>1.5.4</json-schema-validator.version>
    <testcontainers.version>2.0.5</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- Keep the embedded family on Apache's released security patch above Boot 4.0.10. -->
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-core</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-el</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat.embed</groupId>
        <artifactId>tomcat-embed-websocket</artifactId>
        <version>${tomcat.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>dev.keynest</groupId>
        <artifactId>keynest-policy</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.keynest</groupId>
        <artifactId>keynest-generate</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.keynest</groupId>
        <artifactId>keynest-seal</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>de.mkammerer</groupId>
        <artifactId>argon2-jvm</artifactId>
        <version>${argon2.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>formatting</id>
      <build>
        <plugins>
          <plugin>
            <groupId>com.diffplug.spotless</groupId>
            <artifactId>spotless-maven-plugin</artifactId>
            <version>3.12.0</version>
            <inherited>false</inherited>
            <configuration>
              <encoding>UTF-8</encoding>
              <lineEndings>UNIX</lineEndings>
              <ratchetFrom>c609e9634b731afc0abc4f1b94a09de8f46a1207</ratchetFrom>
              <java>
                <includes>
                  <include>libs/*/src/main/java/**/*.java</include>
                  <include>libs/*/src/test/java/**/*.java</include>
                  <include>apps/manager-api/src/main/java/**/*.java</include>
                  <include>apps/manager-api/src/test/java/**/*.java</include>
                  <include>examples/external-consumer/src/main/java/**/*.java</include>
                  <include>examples/external-consumer/src/test/java/**/*.java</include>
                </includes>
                <eclipse>
                  <version>4.37</version>
                  <file>${project.basedir}/config/eclipse-java-formatter.xml</file>
                </eclipse>
                <trimTrailingWhitespace/>
                <endWithNewline/>
              </java>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>coverage</id>
      <properties>
        <keynestCoverageArgLine></keynestCoverageArgLine>
        <argLine></argLine>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <argLine>@{keynestCoverageArgLine} ${argLine}</argLine>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <executions>
              <execution>
                <id>coverage-agent</id>
                <goals><goal>prepare-agent</goal></goals>
                <configuration>
                  <propertyName>keynestCoverageArgLine</propertyName>
                  <includes><include>dev.keynest.*</include></includes>
                </configuration>
              </execution>
              <execution>
                <id>coverage-report</id>
                <phase>test</phase>
                <goals><goal>report</goal></goals>
                <configuration>
                  <formats><format>XML</format><format>HTML</format></formats>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
