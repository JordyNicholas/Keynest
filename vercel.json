{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix apps/manager-web",
  "buildCommand": "npm run build --prefix apps/manager-web",
  "outputDirectory": "apps/manager-web/dist/manager-web/browser",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
