{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keynest.dev/schemas/vault-export-v1.schema.json",
  "title": "Keynest portable Vault payload v1 (unencrypted intermediate)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "exportedAt",
    "accountPolicy",
    "items"
  ],
  "properties": {
    "format": {
      "const": "keynest.vault"
    },
    "version": {
      "const": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "accountPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rules"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 120,
          "minLength": 1
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requireUpper",
            "requireLower",
            "requireDigit",
            "requireSymbol",
            "excludeAmbiguous",
            "forbidWhitespace",
            "forbidUsernameSubstring",
            "minLength",
            "maxLength",
            "minCategories",
            "maxAgeDays",
            "bannedSubstrings",
            "bannedRegexes"
          ],
          "properties": {
            "requireUpper": {
              "type": "boolean"
            },
            "requireLower": {
              "type": "boolean"
            },
            "requireDigit": {
              "type": "boolean"
            },
            "requireSymbol": {
              "type": "boolean"
            },
            "excludeAmbiguous": {
              "type": "boolean"
            },
            "forbidWhitespace": {
              "type": "boolean"
            },
            "forbidUsernameSubstring": {
              "type": "boolean"
            },
            "minLength": {
              "type": "integer",
              "minimum": 8,
              "maximum": 128
            },
            "maxLength": {
              "type": "integer",
              "minimum": 8,
              "maximum": 128
            },
            "minCategories": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "maxAgeDays": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1,
              "maximum": 36500
            },
            "bannedSubstrings": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "bannedRegexes": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "enum": [
                  "(.)\\1{3,}"
                ]
              }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "url",
          "username",
          "password",
          "policyId",
          "expiresAt",
          "lastRotatedAt",
          "notifyBeforeDays",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "label": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000
          },
          "username": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 320
          },
          "password": {
            "type": "string",
            "maxLength": 8192,
            "minLength": 1
          },
          "policyId": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastRotatedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "notifyBeforeDays": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 36500
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
