{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keynest.dev/schemas/password-policy.schema.json",
  "title": "Keynest Password Policy",
  "description": "Declarative password standards used by generate, create, update, and rotate. Same document drives validate and generate — no divergent rule sets.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "rules", "appliesTo"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$",
      "description": "Stable policy identifier, e.g. keynest.default.v1"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Document format version for this policy payload"
    },
    "description": {
      "type": "string"
    },
    "appliesTo": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["generate", "create", "update", "rotate"]
      },
      "description": "Operations allowed to use this policy"
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minLength",
        "maxLength",
        "requireUpper",
        "requireLower",
        "requireDigit",
        "requireSymbol",
        "minCategories",
        "excludeAmbiguous",
        "forbidWhitespace",
        "forbidUsernameSubstring"
      ],
      "properties": {
        "minLength": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "requireUpper": { "type": "boolean" },
        "requireLower": { "type": "boolean" },
        "requireDigit": { "type": "boolean" },
        "requireSymbol": { "type": "boolean" },
        "minCategories": { "type": "integer", "minimum": 0, "maximum": 4 },
        "excludeAmbiguous": {
          "type": "boolean",
          "description": "Reject ambiguous characters 0 O I l 1"
        },
        "forbidWhitespace": { "type": "boolean" },
        "forbidUsernameSubstring": {
          "type": "boolean",
          "description": "Reject passwords containing username/email local-part (length >= 3)"
        },
        "maxAgeDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "description": "Suggested rotation window; enforced by Manager notify/rotate later"
        },
        "bannedSubstrings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Skeleton: denylist substrings (case-insensitive). Not fully enforced yet."
        }
      }
    }
  }
}
