# Repo-wide EditorConfig — https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Match indent_size for wrapped lines in JetBrains / compatible IDEs.
ij_continuation_indent_size = 2

[*.{java,kt}]
indent_size = 2
ij_continuation_indent_size = 2

[*.{ts,tsx,js,mjs,cjs,json,html,css,scss,yml,yaml,xml,properties}]
indent_size = 2

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
